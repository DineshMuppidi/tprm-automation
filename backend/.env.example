# Copy to .env and adjust. Nothing here requires a paid service by default —
# LLM_PROVIDER and EMAIL_PROVIDER both default to local, free mock adapters.

DATABASE_URL=postgresql://tprm:tprm@localhost:5432/tprm

# JWT signing secret for vendor/staff portal sessions (magic-link auth).
# Generate your own for anything beyond local dev: `openssl rand -hex 32`
# (must be >=32 bytes for HMAC-SHA256 — PyJWT warns below that threshold)
AUTH_SECRET=dev-only-secret-change-me-before-any-real-deployment

# Shared-secret header (X-Admin-Key) gating internal/admin endpoints in this
# phase. Phase 5 replaces this with real SSO/OAuth2 + RBAC per the threat model.
ADMIN_API_KEY=dev-admin-key

# mock (default, offline, deterministic) | live (calls Anthropic API)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# console (default, logs to stdout) | smtp
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=tprm-noreply@example.com

# Base URL the frontend is served from, used to build magic-link URLs in emails
APP_BASE_URL=http://localhost:5173

# Local filesystem evidence storage root (stands in for the S3 bucket from
# the Phase 0 architecture doc)
STORAGE_ROOT=./storage

# Phase 2 monitoring providers — mock (default, offline, deterministic) | live
# NVD and SEC EDGAR live providers are free/keyless and work with no key set.
# HIBP and NewsAPI live providers need a real key or they'll return nothing.
CERT_REGISTRY_PROVIDER=mock
BREACH_PROVIDER=mock
NEWS_PROVIDER=mock
FINANCIAL_PROVIDER=mock
HIBP_API_KEY=
NVD_API_KEY=
NEWSAPI_API_KEY=

# Minutes an unacknowledged critical/high alert can sit before auto-escalating
ESCALATION_SLA_MINUTES_CRITICAL=60
ESCALATION_SLA_MINUTES_HIGH=240
ALERT_SUPPRESSION_DEFAULT_DAYS=90
